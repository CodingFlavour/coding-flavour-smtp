{
  "name": "coding-flavour-smtp",
  "version": "2.0.1-alpha.1",
  "main": "./index.ts",
  "bin": "./src/app.ts",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest test/unit --silent",
    "test:integration": "jest test/integration --silent",
    "dev": "nodemon ./src/app.ts",
    "preprod": "ts-node ./src/app.ts --transpile-only",
    "companion:install": "tsx -r tsconfig-paths/register ./node_modules/@coding-flavour/companion/src/bin/companion.ts install",
    "build": "tsc",
    "postbuild": "tsc-esm-fix --target=dist --ext=\".js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "SMTP service for Coding Flavour",
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "nodemailer": "^7.0.13",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.1",
    "tsc-esm-fix": "^3.1.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@coding-flavour/companion": "1.5.1-alpha.0",
    "@types/nodemailer": "^7.0.9"
  }
}
